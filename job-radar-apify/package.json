{
  "name": "job-radar-apify",
  "version": "1.0.0",
  "description": "Standalone job scraper using Apify and syncing directly to Notion",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "vite build --outDir public",
    "start": "vite build --outDir public && tsx src/server.ts",
    "server": "tsx src/server.ts",
    "dev": "vite",
    "cli": "tsx src/index.ts"
  },
  "dependencies": {
    "@notionhq/client": "^5.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.18",
    "@radix-ui/react-toast": "^1.2.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "got-scraping": "^4.2.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.0",
    "vite": "^8.1.5"
  }
