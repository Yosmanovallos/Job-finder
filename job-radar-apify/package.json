    "test:extract-technologies": "tsx tests/validate-extract-technologies.ts",
    "test:utils": "tsx tests/validate-utils.ts",
    "test:seo": "tsx tests/validate-seo-job-pages.ts",
    "test:social-publisher": "tsx tests/validate-social-publisher.ts",
