{
  "name": "job-radar-apify",
  "version": "1.0.0",
  "description": "Standalone job radar dashboard with internal scrapers, Postgres persistence, Supabase auth and Notion sync",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build --outDir public",
    "start": "vite build --outDir public && tsx src/server.ts",
    "server": "tsx src/server.ts",
    "server:cron": "ENABLE_CRON=true tsx src/server.ts",
    "dev": "vite",
    "cli": "tsx src/index.ts",
    "test:adapters": "tsx tests/validate-adapters.ts",
    "test:dedupe": "tsx tests/validate-db-dedupe.ts",
    "test:paywall": "tsx tests/validate-paywall-auth.ts",
    "test:password-reset": "tsx tests/validate-password-reset.ts",
    "test:payment-flow": "tsx tests/validate-payment-flow.ts",
    "test:dashboard-filters": "tsx tests/validate-dashboard-filters.ts",
    "test:seo": "tsx tests/validate-seo-job-pages.ts",
    "test:social-publisher": "tsx tests/validate-social-publisher.ts"
  },
  "dependencies": {
    "@notionhq/client": "^5.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.18",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.21",
    "@supabase/supabase-js": "^2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "got-scraping": "^4.2.1",
    "lucide-react": "^1.26.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "playwright": "^1.62.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.0",
    "vite": "^8.1.5"
  }
}
